<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="电机 + 磁编码器"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="未连接 · 找 OEZ-RPM"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScan"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="扫描"
                android:textColor="@color/text"
                app:strokeColor="@color/muted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConnect"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="连接"
                android:textColor="@color/bg"
                app:backgroundTint="@color/accent" />
        </LinearLayout>

        <Spinner
            android:id="@+id/deviceSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@color/panel"
            android:paddingHorizontal="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@color/panel"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="电机实测转速"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/rpmValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="未收到"
                android:textColor="@color/accent"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RPM"
                android:textColor="@color/muted"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/targetText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="目标 —"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/outFreqText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="输出(霍尔实测): —\n设计 i=(59×79)/(12×14)≈27.744"
                android:textColor="@color/accent_bright"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="最近 8 秒转速"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <com.oezcon.motorblecontrol.RpmChartView
            android:id="@+id/rpmChart"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="6dp"
            android:background="@color/panel" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="启动"
                android:textColor="@color/bg"
                android:textSize="18sp"
                app:backgroundTint="@color/accent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="停止"
                android:textColor="@color/btn_on"
                android:textSize="18sp"
                app:backgroundTint="@color/danger" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="设定转速"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/rpmInput"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@color/panel"
                android:hint="例如 2000"
                android:inputType="number"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetRpm"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:minWidth="88dp"
                android:text="设定"
                android:textColor="@color/btn_on"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/btn"
                app:rippleColor="@color/accent_bright" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="预定转速"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="2"
            android:rowCount="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnP1200"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="1200"
                android:textColor="@color/btn_on"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@color/btn"
                app:rippleColor="@color/accent_bright" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnP2400"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="2400"
                android:textColor="@color/btn_on"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@color/btn"
                app:rippleColor="@color/accent_bright" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnP3600"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="3600"
                android:textColor="@color/btn_on"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@color/btn"
                app:rippleColor="@color/accent_bright" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnP4800"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="4800"
                android:textColor="@color/btn_on"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@color/btn"
                app:rippleColor="@color/accent_bright" />
        </GridLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="协议同 PC：OEZ-RPM / Nordic UART。无需改 ESP32 固件。"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
