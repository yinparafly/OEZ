<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AS5047P ABI 转速监控"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="未连接 · 找 OEZ-ABI"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScan"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="扫描"
                android:textColor="@color/text"
                app:strokeColor="@color/muted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConnect"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="连接"
                android:textColor="@color/bg"
                app:backgroundTint="@color/accent" />
        </LinearLayout>

        <Spinner
            android:id="@+id/deviceSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@color/panel"
            android:paddingHorizontal="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@color/panel"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当前转速（实时，与是否记录无关）"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/rpmValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="—"
                android:textColor="@color/accent"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RPM"
                android:textColor="@color/muted"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/dirText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="方向 —"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/revsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="I圈数 —"
                android:textColor="@color/accent_bright"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/timeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="时间 —"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRevsClear"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:text="清零圈数"
                android:textColor="@color/text"
                app:strokeColor="@color/muted" />

            <TextView
                android:id="@+id/monText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="未武装"
                android:textColor="@color/accent_bright"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/logText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="log_n=0"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="转速曲线（实时 / 已选段）"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <com.oezcon.abirpmonitor.RpmChartView
            android:id="@+id/rpmChart"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="6dp"
            android:background="@color/panel" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="已接收数据段"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/segSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@color/panel"
            android:padding="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="t0"
                android:textColor="@color/muted" />

            <EditText
                android:id="@+id/editT0"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@color/panel"
                android:hint="0.0"
                android:inputType="numberDecimal"
                android:padding="8dp"
                android:text="0.0"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="t1"
                android:textColor="@color/muted" />

            <EditText
                android:id="@+id/editT1"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@color/panel"
                android:hint="0.3"
                android:inputType="numberDecimal"
                android:padding="8dp"
                android:text="0.3"
                android:textColor="@color/text"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplyWin"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="应用窗口"
                android:textColor="@color/text"
                android:textSize="12sp"
                app:strokeColor="@color/muted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWin03"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="0~0.3s"
                android:textColor="@color/text"
                android:textSize="12sp"
                app:strokeColor="@color/muted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWinFull"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="全段"
                android:textColor="@color/text"
                android:textSize="12sp"
                app:strokeColor="@color/muted" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewSeg"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="查看曲线"
                android:textColor="@color/bg"
                app:backgroundTint="@color/accent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlay"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="回放选中"
                android:textColor="@color/btn_on"
                app:backgroundTint="@color/btn" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLiveChart"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:text="切回实时曲线"
            android:textColor="@color/text"
            app:strokeColor="@color/muted" />

        <TextView
            android:id="@+id/playInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="尚未接收数据段"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/dumpProgText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textColor="@color/accent_bright"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="确认后记录时长（0.5~3.0 秒）"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <SeekBar
                android:id="@+id/seekRecMs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="25"
                android:progress="5" />

            <TextView
                android:id="@+id/recMsLabel"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="1.0 s"
                android:textColor="@color/text"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMonStart"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="开始监控"
                android:textColor="@color/bg"
                android:textSize="16sp"
                app:backgroundTint="@color/accent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMonStop"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="停止监控"
                android:textColor="@color/btn_on"
                android:textSize="16sp"
                app:backgroundTint="@color/danger" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDump"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="拉取回放"
                android:textColor="@color/text"
                app:strokeColor="@color/muted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClear"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="清空板内"
                android:textColor="@color/text"
                app:strokeColor="@color/muted" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="曲线段：双指缩放 / 拖动平移 / 双击全段。可设 t0~t1（如 0~0.3s）拉长时间轴。"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
